# ESP-IDF configuration of galagino (all PlatformIO envs). Everything not
# listed keeps the IDF default.

# CPU and flash
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# 4 MB boards; 16 MB boards add sdkconfig.defaults.16mb (platformio.ini)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# 1 ms tick: sleepMs(1) and the pacing in Video::endFrame()
CONFIG_FREERTOS_HZ=1000

# The frame loop (main task) runs on core 0 (hal::VIDEO_CORE), 8 KB stack;
# a layout's sdkconfig.defaults.<layout> (extraScript.py) may cut it
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y

# Task watchdog: hal::watchdogWatch() sets the timeout; idle tasks watched
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# Size (-Os), as the old Arduino build; hot paths sit in IRAM
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Less log, no Bluetooth (WiFi only in remote builds)
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BT_ENABLED=n
