# romconv output outside the machine dirs
source/src/catalog.h
source/src/emulation/pokey_poly.h
source/test/**/*_fixture.h
source/test/test_bundle_unpack/fixture.h

# menu logos generated by romconv (romconv/romconv/gfx/logo.py)
source/src/machines/*/*_logo.h

# remote asset bundles written by romconv
galagino-server/data/
