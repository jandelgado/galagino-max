{
  "packages": [
    "python@3.13",
    "uv@latest",
    "gcc-arm-embedded@latest",
    "ninja@latest",
    "picotool@latest",
    "zlib@latest",
    "cmake@latest",
  ],
  // romconv's highspy wheel links the system libz.so.1; nix's python never
  // looks in /usr/lib64, so zlib comes from the packages above and its lib
  // dir goes on the loader path (devbox's documented way for pip wheels
  // with system libraries; harmless where unneeded).
  // PATH: source/tools/pio, the uv-run PlatformIO, as plain `pio`
  "env": {
    "LD_LIBRARY_PATH": "$DEVBOX_PACKAGES_DIR/lib",
    "PATH": "$PWD/source/tools:$PATH",
  },
}
